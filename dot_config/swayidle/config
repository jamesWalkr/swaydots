# 1. lock the screen after 10 minutes of idle
# 2. turn off display 10 minutes after screen is locked
# 3. suspend 5 minutes ater display is turned off


timeout 600 '~/Scripts/lock'
timeout 1200 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
timeout 1500 'systemctl suspend-then-hibernate'
before-sleep '~/Scripts/lock'
after-resume 'swaymsg "output * power on"'




